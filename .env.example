# Copy to .env and adjust. Every setting is optional.
# See docs/configuration.md for details.

# Preferred transcript languages, in order (comma-separated language codes).
VINK_LANGUAGES=en

# Fall back to YouTube's machine translation when no track matches.
VINK_ALLOW_TRANSLATION=true

# Where generated Markdown files are written.
VINK_OUTPUT_DIR=output

# Local transcript cache. Leave unset to use the platform's user cache directory.
# VINK_CACHE_DIR=
VINK_USE_CACHE=true

# Target length of one chunk, in seconds (used by the MCP get_chunk tool).
VINK_CHUNK_SECONDS=600

# Network timeout for metadata requests, in seconds.
VINK_HTTP_TIMEOUT=10

# DEBUG, INFO, WARNING, or ERROR.
VINK_LOG_LEVEL=WARNING

# --- Reaching YouTube from cloud servers (see docs/hosting.md) ---
# Generic HTTP(S) proxy; must include a numeric port.
# VINK_PROXY_URL=http://user:pass@proxy.example.com:8080
# Or Webshare rotating residential proxies (set both):
# VINK_WEBSHARE_USERNAME=
# VINK_WEBSHARE_PASSWORD=

# --- MCP server ---
# VINK_MCP_TRANSPORT=stdio        # or: http
# VINK_MCP_HOST=127.0.0.1
# VINK_MCP_PORT=8000
# Required for the HTTP transport; at least 16 characters.
# VINK_AUTH_TOKEN=
# VINK_ALLOWED_HOSTS=vink.example.com
